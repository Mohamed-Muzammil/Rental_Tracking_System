# Copy this file to .env.local and fill in your own Supabase project values
# (Project Settings -> API in the Supabase dashboard). .env.local is
# gitignored, so your real keys never get committed.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# Only needed if you run scripts/seed.mjs. Never prefix this with VITE_ —
# that would ship it to the browser bundle.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxx
